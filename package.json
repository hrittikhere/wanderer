{
  "name": "@wanderer/talks",
  "version": "0.1.0",
  "description": "Plugin-based React components and pure helpers for publishing a speaking history: list view, optional 3D globe, search, filters, upcoming grouping, and typed links. Framework-agnostic.",
  "license": "MIT",
  "author": "Hrittik Roy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hrittikhere/wanderer.git"
  },
  "homepage": "https://github.com/hrittikhere/wanderer#readme",
  "bugs": {
    "url": "https://github.com/hrittikhere/wanderer/issues"
  },
  "keywords": [
    "react",
    "talks",
    "speaking",
    "conference",
    "globe",
    "cobe",
    "component",
    "typescript"
  ],
  "type": "module",
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "typesVersions": {
    "*": {
      "helpers": [
        "./dist/types/helpers.d.ts"
      ],
      "list": [
        "./dist/types/list.d.ts"
      ],
      "globe": [
        "./dist/types/globe.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./helpers": {
      "import": {
        "types": "./dist/types/helpers.d.ts",
        "default": "./dist/esm/helpers.js"
      },
      "require": {
        "types": "./dist/cjs/helpers.d.ts",
        "default": "./dist/cjs/helpers.js"
      }
    },
    "./list": {
      "import": {
        "types": "./dist/types/list.d.ts",
        "default": "./dist/esm/list.js"
      },
      "require": {
        "types": "./dist/cjs/list.d.ts",
        "default": "./dist/cjs/list.js"
      }
    },
    "./globe": {
      "import": {
        "types": "./dist/types/globe.d.ts",
        "default": "./dist/esm/globe.js"
      },
      "require": {
        "types": "./dist/cjs/globe.d.ts",
        "default": "./dist/cjs/globe.js"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.22.2 || ^24.15.0 || >=26.0.0",
      "onFail": "warn"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/tsc.mjs -p tsconfig.test.json --noEmit",
    "test": "npm run build && npm run typecheck && npm run test:unit && node scripts/verify-dist.mjs",
    "test:unit": "node scripts/test.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "test:runtime": "node scripts/runtime-smoke.mjs",
    "test:compat": "node scripts/react-compat.mjs",
    "prepack": "npm run build",
    "test:package": "node scripts/package-smoke.mjs",
    "test:browser": "npm run build && playwright test"
  },
  "peerDependencies": {
    "cobe": "^0.6.5",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "cobe": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^20.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "cobe": "^0.6.5",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
